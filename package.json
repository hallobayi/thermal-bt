{
  "name": "thermal-bt",
  "version": "0.1.0",
  "description": "ESC/POS printing from the browser to an Android thermal printer app (RawBT, or Raw Thermal)",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test \"tests/**/*.test.ts\"",
    "build": "tsc -p tsconfig.build.json",
    "verify": "npm run typecheck && npm test && npm run build",
    "codepages": "node scripts/generate-codepage-tables.mjs",
    "examples": "node scripts/serve-examples.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "iconv-lite": "^0.6.3",
    "typescript": "^5.9.2"
  }
}

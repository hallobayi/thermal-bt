{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    /*
     * Source files import each other with an explicit `.ts` extension so that `node --test`
     * can run the sources directly (Node strips types; it cannot guess an extension).
     * `rewriteRelativeImportExtensions` rewrites those to `.js` on emit, which is what lets a
     * single source tree serve both the test runner and the published build.
     */
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,

    /*
     * The sources are executed directly by `node --test`, which strips types rather than
     * compiling them. That rules out anything with runtime semantics: enums, namespaces, and
     * parameter properties. Without this flag the first such construct only fails when the test
     * runner hits it, which is a slow way to find out.
     */
    "erasableSyntaxOnly": true,

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,

    /* This config only type-checks. `tsconfig.build.json` is the one that emits. */
    "noEmit": true
  },
  "include": ["src", "tests", "scripts"]
}
